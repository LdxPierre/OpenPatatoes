PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgres://openpatatoes:openpatatoes@localhost:55432/openpatatoes
OP_BASE_URL=https://openproject.example.com
# Compte administrateur créé au premier démarrage (12 caractères minimum)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
# false uniquement en développement sur HTTP
COOKIE_SECURE=false
# Clé de chiffrement des jetons OP, 32 octets en base64 : openssl rand -base64 32
# Ne jamais la commiter ; la perdre rend illisibles les jetons stockés.
OP_TOKEN_ENCRYPTION_KEY=
# Base dédiée aux tests (recréée à chaque lancement de la suite)
TEST_DATABASE_URL=postgres://openpatatoes:openpatatoes@localhost:55432/openpatatoes_test
