{
  "name": "openpatatoes",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:e2e": "pnpm --filter @openpatatoes/e2e test:e2e",
    "typecheck": "pnpm -r run typecheck",
    "db:generate": "pnpm --filter @openpatatoes/server run db:generate",
    "db:migrate": "pnpm --filter @openpatatoes/server run db:migrate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "eslint": "^10.13.0"
  }
}
