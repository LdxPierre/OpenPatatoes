# Variables de compose.yml. Copiez ce fichier en .env, qui n'est jamais commité.

# URL de l'instance OpenProject
OP_BASE_URL=https://openproject.example.com
# Clé de chiffrement des jetons OP, 32 octets en base64 : openssl rand -base64 32
# La perdre rend illisibles les jetons stockés.
OP_TOKEN_ENCRYPTION_KEY=
# Mot de passe de PostgreSQL, sans caractère spécial d'URL : openssl rand -hex 24
POSTGRES_PASSWORD=
# Compte administrateur créé au premier démarrage (12 caractères minimum)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Cookie de session réservé à HTTPS. Mettez false pour essayer l'app en HTTP ailleurs que sur localhost.
COOKIE_SECURE=true
# Port de l'application web sur la machine hôte
WEB_PORT=8080
